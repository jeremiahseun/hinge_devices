{
  "name": "hinge_devices",
  "version": "0.3.0",
  "description": "A unified posture, hinge and display model for foldable devices. Posture-first, capability-driven, and safe to add to any app.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "tsc --noEmit",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "react-native",
    "foldable",
    "hinge",
    "fold",
    "posture",
    "adaptive-ui",
    "dual-screen",
    "android",
    "galaxy-fold",
    "galaxy-flip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremiahseun/hinge_devices.git",
    "directory": "react-native"
  },
  "author": "Jeremiah Seun",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/jeremiahseun/hinge_devices/issues"
  },
  "homepage": "https://github.com/jeremiahseun/hinge_devices#readme",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "jest": "^29.7.0",
    "react": "^19.3.0",
    "react-native": "^0.79.7",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "codegenConfig": {
    "name": "RNHingeDevicesSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "dev.jeremiahseun.hinge_devices"
    }
  }
}
